# systemd unit for the RemoteCraft relay.
#   sudo install -m 755 RemoteCraft.Relay-2.0.0-linux-x64 /opt/remotecraft-relay/RemoteCraft.Relay
#   sudo cp remotecraft-relay.service /etc/systemd/system/
#   sudo systemctl edit remotecraft-relay   # set Environment=RCRELAY_KEY=<your key>
#   sudo systemctl enable --now remotecraft-relay
[Unit]
Description=RemoteCraft relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/remotecraft-relay/RemoteCraft.Relay
Environment=RCRELAY_PORT=7180
Environment=RCRELAY_DATA=/var/lib/remotecraft-relay
# Set the relay key with "systemctl edit" (keeps it out of this file):
# Environment=RCRELAY_KEY=change-me
DynamicUser=yes
StateDirectory=remotecraft-relay
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
